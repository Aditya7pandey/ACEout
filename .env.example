# --- The way to ship -------------------------------------------------------
#
# Point the app at the voice proxy in ../server. No key is then compiled into
# the bundle: the app posts audio and questions to these endpoints and the
# proxy holds the credentials.
#
#   local machine, web browser   http://localhost:3000
#   local machine, phone on LAN  http://192.168.x.x:3000   (see server/README)
#   deployed                     https://your-app.onrender.com
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# --- The way to prototype --------------------------------------------------
#
# Leave API_BASE_URL blank to call Deepgram and Gemini straight from the app
# with these keys. Convenient while building; never ship a build this way —
# EXPO_PUBLIC_* values are inlined into the JS bundle and can be read out of
# the APK with `unzip`, and both services bill per request.
#

